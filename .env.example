# Database
POSTGRES_USER=yeawyow
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=tarawitDB

# CORS (ใช้ * ถ้าเข้าผ่าน domain เดียว)
CORS_ALLOW_ORIGINS=https://your-domain.com

